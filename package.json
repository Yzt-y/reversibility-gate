{
  "name": "dsh-reversibility-gate",
  "version": "0.1.0",
  "description": "Reversibility-based tool-call policy plugin for DeepSeek Harness: risk tiers, progressive per-signature trust, monotonic self-protection guards, and a fail-closed JSONL audit trail",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "tool-policy",
    "permissions",
    "audit"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": ">=5.7 <7"
  }
}
